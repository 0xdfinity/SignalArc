    "security:install-hooks": "git config core.hooksPath .githooks",
    "proof:terminal": "node scripts/terminal-proof-run.mjs",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:deploy:arc": "hardhat run scripts/deploy-contracts.cjs --network arcTestnet"
